# Laravel API gateway consumed by the mobile app.
# Android emulator: http://10.0.2.2:8000/api
# iOS simulator: http://127.0.0.1:8000/api
# Physical devices: use the computer LAN IP for local development.
API_BASE_URL=https://api.example.com/api

# Native gRPC service, when enabled by the backend.
GRPC_BASE_URL=https://grpc.example.com

# Realtime notifications
PUSHER_APP_KEY=
PUSHER_APP_CLUSTER=
